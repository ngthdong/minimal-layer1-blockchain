# Build output
/bin/
*.exe
*.test
*.out
logs/.sim_bin

# Logs generated while developing. Final logs for submission are added
# explicitly with `git add -f logs/<file>.log` at the end of the project.
logs/*
!logs/.gitkeep

# Coverage and profiling
*.coverprofile
coverage.html
*.pprof

# Editors and OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Local Go workspace files must not leak into the submission
go.work
go.work.sum